      "css": ".ds-button-white{font-family:Manrope,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:30px;min-height:52px;padding:15px 23px;border:0;border-radius:9px;background:white;color:var(--deep,#163c5a);font-size:14px;font-weight:600;cursor:pointer;transition:background .2s,transform .2s}.ds-button-white svg{width:22px;height:22px}.ds-button-white:hover{background:#def2f2}.ds-button-white:active{transform:scale(.98)}.ds-button-white:focus-visible{outline:3px solid #2a829b;outline-offset:5px}.ds-button-white:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-white{transition:none}}"
